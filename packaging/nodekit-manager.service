[Unit]
Description=NodeKit subscription and usage manager
After=network-online.target nodekit-core.service
Wants=network-online.target

[Service]
Type=simple
User=nodekit
Group=nodekit
UMask=0077
WorkingDirectory=/var/lib/nodekit
ExecStart=/opt/nodekit/current/nodekit serve
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/nodekit /run/nodekit

[Install]
WantedBy=multi-user.target
